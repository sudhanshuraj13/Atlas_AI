# Atlas AI — Python Microservice Environment Variables
# Copy this file to .env and fill in the values.

# Server
PORT=8000

# LLM Provider API Keys (3-Tier Fallback)
# Tier 1: Groq (Primary — ultra-fast inference)
GROQ_API_KEY="your_groq_api_key_here"

# Tier 2: Google Gemini (Secondary — high context window)
GOOGLE_API_KEY="your_google_generative_ai_api_key_here"

# Tier 3: OpenAI (Tertiary — maximum reliability safety net)
OPENAI_API_KEY="your_openai_api_key_here"
