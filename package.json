{
  "name": "atlas-ai",
  "version": "1.0.0",
  "description": "Atlas AI — Production-grade Telegram Assistant",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.31",
    "@ai-sdk/openai": "^4.0.27",
    "@prisma/client": "^6.9.0",
    "ai": "^7.0.48",
    "dotenv": "^16.5.0",
    "grammy": "^1.35.0",
    "node-cron": "^4.6.0",
    "yahoo-finance2": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
