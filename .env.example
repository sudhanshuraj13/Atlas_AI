# Atlas AI — Environment Variables
# Copy this file to .env and fill in the values.

TELEGRAM_BOT_TOKEN="your-telegram-bot-token-here"
DATABASE_URL="postgresql://user:password@localhost:5432/atlas_ai?schema=public"

# AI Providers (At least one required; Groq is recommended for ultra-fast, per-minute rate limits)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GOOGLE_GENERATIVE_AI_API_KEY="your-google-gemini-api-key-here"
OPENAI_API_KEY="sk-your-openai-api-key-here"
